# Resolve react_native_pods.rb with node
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Flipper setup (optional, disabled)
begin
  require 'flipper'
  require 'flipper/configuration'
  flipper_config = Flipper::Configuration.disabled
rescue LoadError
  flipper_config = nil
end

platform :ios, '15.1'
prepare_react_native_project!

# 👇 force static linkage & modular headers
use_frameworks! :linkage => :static
use_modular_headers!

target 'FishingNutTv' do
  config = use_native_modules!

  flags = get_default_flags()

  # Permissions pods
  permissions_path = '../node_modules/react-native-permissions/ios'
  pod 'Permission-Camera', :path => "#{permissions_path}/Camera"

  # React Native pods
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => false  # 👈 new architecture off
  )

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # simulator arm64 problem fix
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        # non-modular include fix
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # warnings as errors ko off
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end
  end
  
end
